generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["airpick"]
}

enum LeadStatus {
  NEW
  CHECKING
  QUOTED
  ASSIGNED
  COMPLETED
  CANCELED

  @@schema("airpick")
}

model Lead {
  id                String      @id @default(cuid())
  name              String
  phone             String
  serviceType       String
  airconType        String
  region            String
  addressDetail     String?
  desiredDate       DateTime?
  message           String?
  status            LeadStatus  @default(NEW)
  assignedPartnerId String?
  images            LeadImage[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
  @@schema("airpick")
}

model LeadImage {
  id     String @id @default(cuid())
  leadId String
  url    String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@schema("airpick")
}

model Price {
  id          String  @id @default(cuid())
  category    String
  serviceName String
  basePrice   Int
  unit        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  @@schema("airpick")
}

model Case {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  region         String
  serviceType    String
  airconType     String
  summary        String
  content        String
  basePrice      Int
  extraPrice     Int
  totalPrice     Int
  published      Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  items          CaseItem[]
  createdAt      DateTime   @default(now())

  @@schema("airpick")
}

model CaseItem {
  id     String @id @default(cuid())
  caseId String
  name   String
  price  Int
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@schema("airpick")
}

model Post {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  excerpt        String
  content        String
  published      Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("airpick")
}

model Region {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  intro     String
  content   String
  faq       Json?
  published Boolean @default(false)

  @@schema("airpick")
}

model Partner {
  id          String           @id @default(cuid())
  name        String
  companyName String?
  phone       String
  active      Boolean          @default(true)
  regions     PartnerRegion[]
  services    PartnerService[]
  createdAt   DateTime         @default(now())

  @@schema("airpick")
}

model PartnerRegion {
  id        String  @id @default(cuid())
  partnerId String
  region    String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@schema("airpick")
}

model PartnerService {
  id          String  @id @default(cuid())
  partnerId   String
  serviceType String
  partner     Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@schema("airpick")
}
